        "description": "Call this tool to get the average of transactions.",
        "jsCode": "function calculateAverageTransactionAmount(transactions) {\n  if (!transactions || transactions.length === 0) {\n    return 0;\n  }\n\n  const total = transactions.reduce((sum, transaction) => {\n    return sum + transaction.transaction_amount;\n  }, 0);\n\n  return total / transactions.length;\n}\n\n// Example usage:\nconst transactions = [\n  {\n    \"id\": 737,\n    \"date\": \"2022-01-26\",\n    \"transaction_amount\": 507.54,\n    \"currency\": \"XOF\",\n    \"merchant\": \"Meeveo\",\n    // ...other fields\n  },\n  // ...more transaction objects\n];\n\nconst average = calculateAverageTransactionAmount(transactions);\nconsole.log(average);",
